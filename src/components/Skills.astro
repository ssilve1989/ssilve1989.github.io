---
import { getCollection } from 'astro:content';
import DistributedSystems from './diagrams/DistributedSystems.astro';
import EventDriven from './diagrams/EventDriven.astro';
import DeploymentDelivery from './diagrams/DeploymentDelivery.astro';
import DataArchitecture from './diagrams/DataArchitecture.astro';
import AiAugmentedEngineering from './diagrams/AiAugmentedEngineering.astro';

const skillsData = await getCollection('skills');

// Ordered narrative: systems, then how they talk to each other, then how
// they ship, then how they persist data, then the skill that ties directing
// AI-generated code back into all of the above.
const CATEGORY_ORDER = [
  'distributed-systems',
  'event-driven',
  'deployment-delivery',
  'data-architecture',
  'ai-augmented-engineering',
] as const;

const DIAGRAMS: Record<(typeof CATEGORY_ORDER)[number], typeof DistributedSystems> = {
  'distributed-systems': DistributedSystems,
  'event-driven': EventDriven,
  'deployment-delivery': DeploymentDelivery,
  'data-architecture': DataArchitecture,
  'ai-augmented-engineering': AiAugmentedEngineering,
};

const orderedSkills = CATEGORY_ORDER.map((slug) =>
  skillsData.find((entry) => entry.data.slug === slug),
).filter((entry) => entry !== undefined);
---

<div class="max-w-6xl mx-auto">
  <div class="text-center mb-16">
    <h2 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">
      Architecture &amp; Systems Thinking
    </h2>
    <p class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
      As AI writes more of the code itself, what matters is understanding the systems it runs in
    </p>
  </div>

  <div class="flex flex-col">
    {orderedSkills.map((entry, index) => {
      const Diagram = DIAGRAMS[entry.data.slug as (typeof CATEGORY_ORDER)[number]];
      const reverse = index % 2 === 1;
      return (
        <div class:list={['grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center py-10 border-t border-gray-200 dark:border-gray-700', { 'border-b': index === orderedSkills.length - 1 }]}>
          <div class:list={['order-1', reverse ? 'md:order-2' : 'md:order-1']}>
            <Diagram />
          </div>
          <div class:list={['order-2', reverse ? 'md:order-1' : 'md:order-2']}>
            <div class="text-xs font-semibold uppercase tracking-wider bg-gradient-to-r from-blue-500 to-purple-600 bg-clip-text text-transparent mb-2">
              {String(index + 1).padStart(2, '0')} — Systems Architecture
            </div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">
              {entry.data.category}
            </h3>
            <p class="text-gray-600 dark:text-gray-300 mb-4 leading-relaxed">
              {entry.data.summary}
            </p>
            <div class="flex flex-wrap gap-2">
              {entry.data.concepts.map((concept) => (
                <span class="text-xs text-gray-600 dark:text-gray-300 bg-gray-100 dark:bg-gray-700 rounded-full px-3 py-1">
                  {concept}
                </span>
              ))}
            </div>
          </div>
        </div>
      );
    })}
  </div>
</div>
