---
import { getCollection } from "astro:content";
import AiAugmentedEngineering from "./diagrams/AiAugmentedEngineering.astro";
import DataArchitecture from "./diagrams/DataArchitecture.astro";
import DeploymentDelivery from "./diagrams/DeploymentDelivery.astro";
import DistributedSystems from "./diagrams/DistributedSystems.astro";
import EventDriven from "./diagrams/EventDriven.astro";

const skillsData = await getCollection("skills");

// Ordered narrative: systems, then how they talk to each other, then how
// they ship, then how they persist data, then the skill that ties directing
// AI-generated code back into all of the above.
const CATEGORY_ORDER = [
	"distributed-systems",
	"event-driven",
	"deployment-delivery",
	"data-architecture",
	"ai-augmented-engineering",
] as const;

const DIAGRAMS: Record<
	(typeof CATEGORY_ORDER)[number],
	typeof DistributedSystems
> = {
	"distributed-systems": DistributedSystems,
	"event-driven": EventDriven,
	"deployment-delivery": DeploymentDelivery,
	"data-architecture": DataArchitecture,
	"ai-augmented-engineering": AiAugmentedEngineering,
};

// Eyebrow per row: where the category sits in the narrative above.
const LABELS: Record<(typeof CATEGORY_ORDER)[number], string> = {
	"distributed-systems": "how systems are shaped",
	"event-driven": "how services talk",
	"deployment-delivery": "how they ship",
	"data-architecture": "how they keep data",
	"ai-augmented-engineering": "where AI fits in",
};

const orderedSkills = CATEGORY_ORDER.map((slug) =>
	skillsData.find((entry) => entry.data.slug === slug),
).filter((entry) => entry !== undefined);
---

<div class="max-w-6xl mx-auto">
  <div class="mb-12 flex flex-col gap-4">
    <p class="font-mono text-[13px] text-signal">Systems</p>
    <h2 class="font-display font-bold text-3xl md:text-[40px] tracking-[-0.03em] text-ink">
      Architecture &amp; systems thinking
    </h2>
    <p class="max-w-2xl text-lg leading-relaxed text-ink-soft">
      As AI writes more of the code itself, what matters is understanding the systems it runs in.
    </p>
  </div>

  <div class="flex flex-col">
    {orderedSkills.map((entry, index) => {
      const slug = entry.data.slug as (typeof CATEGORY_ORDER)[number];
      const Diagram = DIAGRAMS[slug];
      const reverse = index % 2 === 1;
      return (
        <div class:list={['grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center py-10 border-t border-rule', { 'border-b': index === orderedSkills.length - 1 }]}>
          <div class:list={['order-1', reverse ? 'md:order-2' : 'md:order-1']}>
            <Diagram />
          </div>
          <div class:list={['order-2', reverse ? 'md:order-1' : 'md:order-2']}>
            <p class="mb-3 font-mono text-[13px] text-signal">
              {String(index + 1).padStart(2, '0')} / {String(orderedSkills.length).padStart(2, '0')} · {LABELS[slug]}
            </p>
            <h3 class="mb-3 font-display font-bold text-2xl md:text-[32px] leading-[1.15] tracking-[-0.025em] text-ink">
              {entry.data.category}
            </h3>
            <p class="mb-4 text-[17px] leading-[1.65] text-ink-soft">
              {entry.data.summary}
            </p>
            <div class="flex flex-wrap gap-2">
              {entry.data.concepts.map((concept) => (
                <span class="rounded border border-rule bg-surface px-2 py-1 font-mono text-xs text-ink-soft">
                  {concept}
                </span>
              ))}
            </div>
          </div>
        </div>
      );
    })}
  </div>
</div>
