---
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
const projects = [
	...allProjects.filter((project) => project.data.type === "opensource"),
	...allProjects.filter((project) => project.data.type !== "opensource"),
].map(({ id, data }) => ({
	id,
	title: data.title,
	description: data.description,
	stack: data.technologies
		.slice(0, 3)
		.map((tech) => tech.toLowerCase())
		.join(" · "),
	href: data.link ?? data.github,
	status:
		data.type === "opensource"
			? "open source"
			: data.link
				? "live site"
				: "private",
}));

const rowClass =
	"grid gap-1 md:grid-cols-[220px_minmax(0,1fr)_200px_100px_16px] md:gap-6 md:items-baseline px-3 py-5 border-b border-rule";
---

<div class="max-w-6xl mx-auto">
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div class="flex flex-col gap-3">
      <p class="font-mono text-[13px] text-signal">Projects</p>
      <h2 class="font-display font-bold text-3xl md:text-[40px] tracking-[-0.03em] text-ink">Things I've built</h2>
    </div>
    <a
      href="https://github.com/ssilve1989"
      target="_blank"
      rel="noopener noreferrer"
      class="font-mono text-[13px] text-signal hover:underline underline-offset-4"
    >
      all repos on GitHub →
    </a>
  </div>

  <ul class="border-t border-rule">
    {projects.map((project) => {
      const cells = (
        <>
          <span class="font-display font-bold text-xl text-ink">{project.title}</span>
          <span class="text-[15px] text-ink-soft">{project.description}</span>
          <span class="font-mono text-xs text-muted">{project.stack}</span>
          <span class="font-mono text-xs text-muted">{project.status}</span>
          <span aria-hidden="true" class="arrow hidden md:inline text-line">{project.href ? "→" : ""}</span>
        </>
      );
      return (
        <li>
          {project.href ? (
            <a
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
              class:list={[rowClass, "group hover:bg-surface transition-colors"]}
            >
              {cells}
            </a>
          ) : (
            <div class={rowClass}>{cells}</div>
          )}
        </li>
      );
    })}
  </ul>
</div>

<style>
  .group:hover .arrow,
  .group:focus-visible .arrow {
    color: var(--signal);
  }
</style>
