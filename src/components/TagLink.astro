---
export interface Props {
	tag: string;
}

const { tag } = Astro.props;
---

<a
  href={`/blog/?tag=${encodeURIComponent(tag)}`}
  data-tag-link={tag}
  class="inline-block rounded border border-rule bg-surface px-2 py-1 font-mono text-xs text-ink-soft transition-colors hover:border-signal hover:text-signal aria-[current=true]:border-signal aria-[current=true]:bg-signal aria-[current=true]:text-ground"
>
  {tag}
</a>
