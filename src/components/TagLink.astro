---
export interface Props {
	tag: string;
}

const { tag } = Astro.props;
---

<a
  href={`/blog/?tag=${encodeURIComponent(tag)}`}
  data-tag-link={tag}
  class="inline-block px-2 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm font-medium hover:bg-blue-100 hover:text-blue-700 dark:hover:bg-gray-600 dark:hover:text-blue-300 transition-colors aria-[current=true]:bg-blue-600 aria-[current=true]:text-white dark:aria-[current=true]:bg-blue-500"
>
  {tag}
</a>
