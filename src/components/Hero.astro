---
import { getSortedPosts } from "../lib/blog";

const [latest] = await getSortedPosts();

const navLinks = [
	{ label: "experience", href: "#experience" },
	{ label: "systems", href: "#skills" },
	{ label: "projects", href: "#projects" },
	{ label: "writing", href: "/blog" },
	{ label: "résumé", href: "/resume" },
];

// Diagram geometry (viewBox 560 x 440): teams on top, the platform band, services, then the event bus.
const teamXs = [0, 192, 384];
const serviceXs = [0, 143, 286, 429];
const platformLabels = [
	{ text: "shared libraries", x: 16, y: 172 },
	{ text: "service contracts", x: 290, y: 172 },
	{ text: "conventions", x: 16, y: 206 },
	{ text: "developer tooling", x: 290, y: 206 },
];
const busCells = Array.from({ length: 16 }, (_, i) => i);
---

<section class="bg-ground px-6 md:px-20 pt-8 pb-20 md:pb-28">
  <div class="max-w-6xl mx-auto">
    <header class="flex flex-wrap items-center justify-between gap-4 pr-14 md:pr-16 font-mono text-[13px] text-muted">
      <a href="/" class="font-medium text-ink">ssilvestri</a>
      <nav aria-label="Primary">
        <ul class="flex flex-wrap gap-x-7 gap-y-2">
          {navLinks.map(({ label, href }) => (
            <li><a href={href} class="hover:text-signal transition-colors">{label}</a></li>
          ))}
        </ul>
      </nav>
    </header>

    <div class="mt-16 md:mt-24 grid items-center gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,560px)]">
      <div class="flex flex-col gap-7">
        <p class="font-mono text-[13px] tracking-wide text-signal">Steven Silvestri · Principal Software Engineer</p>
        <h1 class="font-display font-bold text-5xl md:text-[68px] leading-[1.02] tracking-[-0.035em] text-ink">
          I design the systems other teams build on.
        </h1>
        <p class="max-w-[520px] text-lg md:text-[19px] leading-relaxed text-ink-soft">
          gRPC microservices, event-driven pipelines, and the shared NestJS libraries that product teams build on.
        </p>
        {latest && (
          <a href={`/blog/${latest.id}`} class="group font-mono text-[13px] text-muted">
            latest post · <span class="text-signal group-hover:underline underline-offset-4">{latest.data.title} →</span>
          </a>
        )}
      </div>

      <!-- Hidden on phones: scaled to fit, its labels drop below a readable size. -->
      <figure class="m-0 hidden sm:block">
        <figcaption class="sr-only">
          Product teams build on a shared platform layer of libraries, contracts, conventions and tooling, which sits on
          gRPC services and an event bus.
        </figcaption>
        <svg viewBox="0 0 560 440" class="hero-diagram w-full max-w-[560px] h-auto" aria-hidden="true">
          <text x="0" y="12" class="fill-muted font-mono" font-size="11">product teams</text>
          {teamXs.map((x) => (
            <>
              <rect x={x + 0.5} y="20.5" width="175" height="47" rx="8" class="fill-surface stroke-line"></rect>
              <text x={x + 14} y="49" class="fill-ink-soft" font-size="14">team</text>
            </>
          ))}

          <g class="stroke-line">
            {teamXs.map((x) => <line x1={x + 88} y1="68" x2={x + 88} y2="270"></line>)}
          </g>

          <rect x="0.75" y="112" width="558.5" height="116" rx="10" class="fill-signal-soft stroke-signal" stroke-width="1.5"></rect>
          <text x="16" y="136" class="fill-signal font-mono" font-size="11" font-weight="500">platform</text>
          <text x="544" y="136" text-anchor="end" class="fill-signal font-mono" font-size="11">← what I build</text>
          {platformLabels.map(({ text, x, y }) => (
            <text x={x} y={y} class="fill-ink font-display" font-size="16" font-weight="700">{text}</text>
          ))}

          {teamXs.map((x, i) => (
            <circle class="drop" cx={x + 88} cy="74" r="4" style={`animation-delay: ${i * 0.85}s`}></circle>
          ))}

          <text x="0" y="262" class="fill-muted font-mono" font-size="11">services</text>
          {serviceXs.map((x) => (
            <>
              <rect x={x + 0.5} y="270.5" width="130" height="43" rx="8" class="fill-surface stroke-ink"></rect>
              <text x={x + 65.5} y="296" text-anchor="middle" class="fill-ink font-mono" font-size="12">svc</text>
            </>
          ))}

          {[69, 348, 491].map((cx, i) => (
            <circle class="emit" cx={cx} cy="319" r="3" style={`animation-delay: ${0.3 + i * 0.4}s`}></circle>
          ))}

          {busCells.map((i) => (
            <rect class="cell stroke-rule" x={i * 35} y="368" width="35" height="30" style={`animation-delay: ${i * 0.5}s`}></rect>
          ))}
          <rect x="0.5" y="368.5" width="559" height="29" rx="4" fill="none" class="stroke-ink"></rect>
          <text x="0" y="418" class="fill-muted font-mono" font-size="11">event bus</text>
        </svg>
      </figure>
    </div>
  </div>
</section>

<style>
  .hero-diagram .drop,
  .hero-diagram .emit {
    fill: var(--signal);
    opacity: 0;
  }
  .hero-diagram .drop { animation: drop 2.6s infinite ease-in-out; }
  .hero-diagram .emit { animation: emit 1.6s infinite ease-in-out; }
  .hero-diagram .cell {
    fill: var(--surface);
    animation: cell 8s infinite;
  }

  @keyframes drop {
    0% { transform: translateY(0); opacity: 0; }
    10%, 90% { opacity: 1; }
    100% { transform: translateY(196px); opacity: 0; }
  }
  @keyframes emit {
    0% { transform: translateY(0); opacity: 0; }
    15%, 85% { opacity: 1; }
    100% { transform: translateY(44px); opacity: 0; }
  }
  @keyframes cell {
    0%, 6% { fill: var(--surface); }
    12%, 100% { fill: var(--signal-soft); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-diagram .drop,
    .hero-diagram .emit,
    .hero-diagram .cell {
      animation: none;
    }
  }
</style>
