---
const links = [
	{
		label: "github.com/ssilve1989",
		href: "https://github.com/ssilve1989",
		external: true,
	},
	{
		label: "linkedin",
		href: "https://www.linkedin.com/in/steven-silvestri-65734780/",
		external: true,
	},
	{ label: "résumé", href: "/resume", external: false },
	{ label: "rss.xml", href: "/rss.xml", external: false },
];
---

<div class="max-w-6xl mx-auto grid items-end gap-12 lg:grid-cols-[minmax(0,1fr)_420px] lg:gap-20">
  <div class="flex flex-col gap-4">
    <p class="font-mono text-[13px] text-signal">Contact</p>
    <h2 class="font-display font-bold text-4xl md:text-[52px] leading-[1.05] tracking-[-0.035em] text-ink">
      Find me on GitHub or LinkedIn.
    </h2>
    <p class="text-lg text-muted">Or subscribe to the RSS feed to get new posts.</p>
  </div>

  <ul class="border-t border-rule font-mono text-[15px]">
    {links.map(({ label, href, external }) => (
      <li class="border-b border-rule">
        <a
          href={href}
          class="flex justify-between py-4 text-ink hover:text-signal transition-colors"
          {...(external && { target: "_blank", rel: "noopener noreferrer" })}
        >
          <span>{label}</span>
          <span aria-hidden="true">{external ? "↗" : "→"}</span>
        </a>
      </li>
    ))}
  </ul>
</div>
