---
import "./kscene.css";
---

<div class="kscene not-prose" style="margin-block: 1rem">
  <div class="kscene-legend" aria-label="Record key colors">
    <span style="--sw: var(--ks-i)">I = inventory level (hot)</span>
    <span style="--sw: var(--ks-u)">U = user</span>
    <span style="--sw: var(--ks-d)">D = discount</span>
    <span style="--sw: var(--ks-t)">T = tax rate</span>
  </div>
</div>
