---
import { getSortedPosts } from "../lib/blog";

const posts = await getSortedPosts();

const facts = [
	{ label: "focus", value: "distributed systems, developer experience" },
	{ label: "stack", value: "TypeScript, Node.js, NestJS, gRPC" },
	{
		label: "writes about",
		value: [...new Set(posts.flatMap((post) => post.data.tags.slice(0, 1)))]
			.slice(0, 4)
			.join(", "),
	},
];
---

<div class="max-w-6xl mx-auto grid gap-14 lg:grid-cols-[minmax(0,1fr)_380px] lg:gap-24">
  <div class="flex flex-col gap-6">
    <p class="font-mono text-[13px] text-signal">About</p>
    <h2 class="max-w-[640px] font-display font-bold text-3xl md:text-[44px] leading-[1.1] tracking-[-0.03em] text-ink">
      I build the libraries and services that let other teams ship without thinking about the plumbing.
    </h2>
    <p class="max-w-[640px] text-lg leading-[1.7] text-ink-soft">
      Most of my work is backend platform engineering: gRPC microservices in Node.js, event-driven pipelines, and the
      developer experience around them. That means shared abstractions, conventions, and review guidance that keep a
      fleet of services consistent as more teams build on it.
    </p>
    <p class="max-w-[640px] text-lg leading-[1.7] text-ink-soft">
      Lately that includes AI agents in the review and authoring loop, and being honest about what they catch and what
      they miss.
    </p>
  </div>

  <dl class="self-end border-t border-rule">
    {facts.map(({ label, value }) => (
      <div class="grid grid-cols-[120px_minmax(0,1fr)] border-b border-rule py-4">
        <dt class="pt-0.5 font-mono text-xs text-muted">{label}</dt>
        <dd class="text-[15px] text-ink">{value}</dd>
      </div>
    ))}
  </dl>
</div>
