---
---

<div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-5 flex items-center justify-center">
  <svg
    id="dd-diagram"
    viewBox="0 0 640 260"
    class="w-full h-auto"
    role="img"
    aria-label="A commit flows through build and test stages to deploy, scaling up a cluster of containers; occasionally a test failure sends it back to build instead, showing the release gate actually gates."
  >
    <path id="dd-pathMain" d="M40,150 L170,150 L310,150 L450,150" class="fill-none stroke-gray-300 dark:stroke-gray-600" stroke-width="2" />
    <path id="dd-pathReturn" d="M310,140 Q240,70 170,140" class="fill-none stroke-gray-300 dark:stroke-gray-600" stroke-width="2" />
    <path id="dd-pathC1" d="M450,150 L575,90" class="fill-none stroke-gray-300 dark:stroke-gray-600" stroke-width="2" />
    <path id="dd-pathC2" d="M450,150 L575,150" class="fill-none stroke-gray-300 dark:stroke-gray-600" stroke-width="2" />
    <path id="dd-pathC3" d="M450,150 L575,210" class="fill-none stroke-gray-300 dark:stroke-gray-600" stroke-width="2" />

    <circle id="dd-commit" cx="40" cy="150" r="18" class="fill-white dark:fill-gray-800 stroke-purple-500 dark:stroke-purple-400" stroke-width="2" />
    <text x="40" y="180" text-anchor="middle" class="fill-gray-700 dark:fill-gray-200" font-size="11">Commit</text>

    <rect id="dd-build" x="140" y="130" width="60" height="40" rx="8" class="fill-white dark:fill-gray-800 stroke-purple-500 dark:stroke-purple-400" stroke-width="2" />
    <text x="170" y="154" text-anchor="middle" class="fill-gray-700 dark:fill-gray-200" font-size="10">Build</text>

    <rect id="dd-test" x="280" y="130" width="60" height="40" rx="8" class="fill-white dark:fill-gray-800 stroke-purple-500 dark:stroke-purple-400" stroke-width="2" />
    <text x="310" y="154" text-anchor="middle" class="fill-gray-700 dark:fill-gray-200" font-size="10">Test</text>
    <text id="dd-badge" x="310" y="118" text-anchor="middle" class="fill-red-500" font-size="10" opacity="0">✕ failed</text>

    <rect id="dd-deploy" x="420" y="130" width="60" height="40" rx="8" class="fill-white dark:fill-gray-800 stroke-purple-500 dark:stroke-purple-400" stroke-width="2" />
    <text x="450" y="154" text-anchor="middle" class="fill-gray-700 dark:fill-gray-200" font-size="10">Deploy</text>

    <circle id="dd-c1" cx="575" cy="90" r="14" class="fill-white dark:fill-gray-800 stroke-purple-500 dark:stroke-purple-400" stroke-width="2" />
    <circle id="dd-c2" cx="575" cy="150" r="14" class="fill-white dark:fill-gray-800 stroke-purple-500 dark:stroke-purple-400" stroke-width="2" />
    <circle id="dd-c3" cx="575" cy="210" r="14" class="fill-white dark:fill-gray-800 stroke-purple-500 dark:stroke-purple-400" stroke-width="2" />

    <circle id="dd-packetMain" r="4.5" class="fill-blue-500 dark:fill-blue-400" />
    <circle id="dd-packetFail" r="4.5" class="fill-red-500" opacity="0" />
  </svg>
</div>

<script>
  import { gsap } from 'gsap';
  import { MotionPathPlugin } from 'gsap/MotionPathPlugin';

  gsap.registerPlugin(MotionPathPlugin);

  function init() {
    const svg = document.getElementById('dd-diagram');
    if (!svg) return;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    const packetMain = svg.querySelector('#dd-packetMain');
    const packetFail = svg.querySelector('#dd-packetFail');
    const badge = svg.querySelector('#dd-badge');
    const test = svg.querySelector('#dd-test');
    const c1 = svg.querySelector('#dd-c1');
    const c2 = svg.querySelector('#dd-c2');
    const c3 = svg.querySelector('#dd-c3');

    const anims: gsap.core.Animation[] = [];

    gsap.set(c1, { scale: 0, svgOrigin: '575 90' });
    gsap.set(c2, { scale: 0, svgOrigin: '575 150' });
    gsap.set(c3, { scale: 0, svgOrigin: '575 210' });

    const travel = gsap.timeline({ repeat: -1 });
    travel
      .to(packetMain, { motionPath: { path: '#dd-pathMain' }, duration: 5.5, ease: 'none' })
      .to(c1, { scale: 1, duration: 0.4, ease: 'back.out(2)' }, '<0.2')
      .to(c2, { scale: 1, duration: 0.4, ease: 'back.out(2)' }, '<0.15')
      .to(c3, { scale: 1, duration: 0.4, ease: 'back.out(2)' }, '<0.15')
      .to([c1, c2, c3], { scale: 0, duration: 0.3 }, '+=1.2')
      .set(packetMain, { motionPath: { path: '#dd-pathMain' } });
    anims.push(travel);

    const incident = gsap.timeline({ repeat: -1 });
    incident
      .to({}, { duration: 8 })
      .to(packetMain, { opacity: 0, duration: 0.1 })
      .to(packetFail, { opacity: 1, duration: 0.1 }, '<')
      .to(packetFail, { motionPath: { path: '#dd-pathReturn' }, duration: 1.6, ease: 'power1.inOut' }, '<')
      .to(badge, { opacity: 1, duration: 0.2 }, '<')
      .to(badge, { opacity: 0, duration: 0.2 }, '+=0.4')
      .to(packetFail, { opacity: 0, duration: 0.1 })
      .to(packetMain, { opacity: 1, duration: 0.1 }, '<')
      .to({}, { duration: 0.3 });
    anims.push(incident);

    anims.forEach((a) => a.pause());

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          for (const a of anims) {
            entry.isIntersecting ? a.play() : a.pause();
          }
        }
      },
      { threshold: 0.2 },
    );
    io.observe(svg);
  }

  init();
</script>
