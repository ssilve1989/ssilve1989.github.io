---
---

<div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-5 flex items-center justify-center">
  <svg
    id="ai-diagram"
    viewBox="0 0 600 340"
    class="w-full h-auto"
    role="img"
    aria-label="An architect directs three AI agents producing code, which passes through a review gate before reaching the production system; one fragment is shown being rejected at review."
  >
    <path d="M300,40 L140,150" class="fill-none stroke-gray-300 dark:stroke-gray-600" stroke-width="2" />
    <path d="M300,40 L300,150" class="fill-none stroke-gray-300 dark:stroke-gray-600" stroke-width="2" />
    <path d="M300,40 L460,150" class="fill-none stroke-gray-300 dark:stroke-gray-600" stroke-width="2" />
    <path id="ai-path1" d="M140,150 L230,222" class="fill-none stroke-gray-300 dark:stroke-gray-600" stroke-width="2" />
    <path id="ai-path2" d="M300,150 L300,222" class="fill-none stroke-gray-300 dark:stroke-gray-600" stroke-width="2" />
    <path id="ai-path3" d="M460,150 L370,222" class="fill-none stroke-gray-300 dark:stroke-gray-600" stroke-width="2" />
    <path id="ai-pathSystem" d="M300,258 L300,292" class="fill-none stroke-gray-300 dark:stroke-gray-600" stroke-width="2" />

    <g id="ai-architect">
      <circle cx="300" cy="40" r="22" class="fill-white dark:fill-gray-800 stroke-purple-500 dark:stroke-purple-400" stroke-width="2" />
      <text x="300" y="44" text-anchor="middle" class="fill-gray-700 dark:fill-gray-200" font-size="11">You</text>
    </g>

    <circle cx="140" cy="150" r="21" class="fill-white dark:fill-gray-800 stroke-purple-500 dark:stroke-purple-400" stroke-width="2" />
    <text x="140" y="154" text-anchor="middle" class="fill-gray-700 dark:fill-gray-200" font-size="8.5">AI Agent</text>
    <circle cx="300" cy="150" r="21" class="fill-white dark:fill-gray-800 stroke-purple-500 dark:stroke-purple-400" stroke-width="2" />
    <text x="300" y="154" text-anchor="middle" class="fill-gray-700 dark:fill-gray-200" font-size="8.5">AI Agent</text>
    <circle cx="460" cy="150" r="21" class="fill-white dark:fill-gray-800 stroke-purple-500 dark:stroke-purple-400" stroke-width="2" />
    <text x="460" y="154" text-anchor="middle" class="fill-gray-700 dark:fill-gray-200" font-size="8.5">AI Agent</text>

    <rect x="230" y="218" width="140" height="40" rx="8" class="fill-white dark:fill-gray-800 stroke-purple-500 dark:stroke-purple-400" stroke-width="2" />
    <text x="300" y="242" text-anchor="middle" class="fill-gray-700 dark:fill-gray-200" font-size="11">Review</text>

    <rect x="220" y="292" width="160" height="40" rx="8" class="fill-white dark:fill-gray-800 stroke-purple-500 dark:stroke-purple-400" stroke-width="2" />
    <text x="300" y="316" text-anchor="middle" class="fill-gray-700 dark:fill-gray-200" font-size="11">Production System</text>

    <rect id="ai-frag1" width="8" height="8" x="-4" y="-4" class="fill-blue-500 dark:fill-blue-400" opacity="0" />
    <rect id="ai-frag2" width="8" height="8" x="-4" y="-4" class="fill-blue-500 dark:fill-blue-400" opacity="0" />
    <rect id="ai-frag3" width="8" height="8" x="-4" y="-4" class="fill-blue-500 dark:fill-blue-400" opacity="0" />
    <circle id="ai-toSystem1" r="4.5" class="fill-emerald-500" opacity="0" />
    <circle id="ai-toSystem3" r="4.5" class="fill-emerald-500" opacity="0" />
  </svg>
</div>

<script>
  import { gsap } from 'gsap';
  import { MotionPathPlugin } from 'gsap/MotionPathPlugin';

  gsap.registerPlugin(MotionPathPlugin);

  function init() {
    const svg = document.getElementById('ai-diagram');
    if (!svg) return;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    const architect = svg.querySelector('#ai-architect');
    const frag1 = svg.querySelector('#ai-frag1');
    const frag2 = svg.querySelector('#ai-frag2');
    const frag3 = svg.querySelector('#ai-frag3');
    const toSystem1 = svg.querySelector('#ai-toSystem1');
    const toSystem3 = svg.querySelector('#ai-toSystem3');

    const anims: gsap.core.Animation[] = [];

    anims.push(
      gsap.to(architect, {
        scale: 1.06,
        svgOrigin: '300 40',
        duration: 1.6,
        ease: 'sine.inOut',
        yoyo: true,
        repeat: -1,
      }),
    );

    const cycle1 = gsap.timeline({ repeat: -1 });
    cycle1
      .to(frag1, { opacity: 1, motionPath: { path: '#ai-path1' }, duration: 1.4, ease: 'power1.in' }, 0)
      .to(frag1, { opacity: 0, duration: 0.2 }, 1.3)
      .to(toSystem1, { opacity: 1, motionPath: { path: '#ai-pathSystem' }, duration: 1, ease: 'none' }, 1.4)
      .to(toSystem1, { opacity: 0, duration: 0.2 }, 2.3);
    anims.push(cycle1);

    const cycle3 = gsap.timeline({ repeat: -1, delay: 1.1 });
    cycle3
      .to(frag3, { opacity: 1, motionPath: { path: '#ai-path3' }, duration: 1.4, ease: 'power1.in' }, 0)
      .to(frag3, { opacity: 0, duration: 0.2 }, 1.3)
      .to(toSystem3, { opacity: 1, motionPath: { path: '#ai-pathSystem' }, duration: 1, ease: 'none' }, 1.4)
      .to(toSystem3, { opacity: 0, duration: 0.2 }, 2.3);
    anims.push(cycle3);

    const cycle2Reject = gsap.timeline({ repeat: -1 });
    cycle2Reject
      .set(frag2, { attr: { x: 296, y: 146 }, opacity: 1, fill: '#3b82f6' })
      .to(frag2, { attr: { y: 190 }, duration: 1.3, ease: 'power1.in' }, 0)
      .to(frag2, { fill: '#ef4444', duration: 0.2 }, 1.2)
      .to(frag2, { attr: { y: 166 }, duration: 0.5, ease: 'power1.out' }, 1.4)
      .to(frag2, { opacity: 0, duration: 0.3 }, 1.9)
      .to({}, { duration: 2.6 });
    anims.push(cycle2Reject);

    anims.forEach((a) => a.pause());

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          for (const a of anims) {
            entry.isIntersecting ? a.play() : a.pause();
          }
        }
      },
      { threshold: 0.2 },
    );
    io.observe(svg);
  }

  init();
</script>
